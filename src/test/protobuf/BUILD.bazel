load("@com_google_protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")

package(
    default_testonly = 1,
    default_visibility = ["//:soy_internal"],
)

java_proto_library(
    name = "test_protos_java_proto",
    deps = [":test_protos"],
)

java_proto_library(
    name = "test_collision_protos_java_proto",
    deps = [":test_collision_protos"],
)

java_proto_library(
    name = "public_import_shim_java_proto",
    deps = [":public_import_shim_proto"],
)

java_proto_library(
    name = "public_import_private_dep_java_proto",
    deps = [":public_import_private_dep_proto"],
)

proto_library(
    name = "test_protos",
    srcs = glob(
        ["*.proto"],
        exclude = [
            "collision.proto",
            "public_import_*.proto",
        ],
    ),
)

proto_library(
    name = "test_collision_protos",
    srcs = ["collision.proto"],
)

# Protos exercising `import public`. Kept out of :test_protos so they are only
# registered by the tests that exercise them, which depend on just the shim:
# shim --(import public)--> middle --(import public)--> target.
proto_library(
    name = "public_import_target_proto",
    srcs = ["public_import_target.proto"],
)

proto_library(
    name = "public_import_middle_proto",
    srcs = ["public_import_middle.proto"],
    exports = [":public_import_target_proto"],
    deps = [":public_import_target_proto"],
)

proto_library(
    name = "public_import_private_dep_proto",
    srcs = ["public_import_private_dep.proto"],
)

proto_library(
    name = "public_import_shim_proto",
    srcs = ["public_import_shim.proto"],
    exports = [":public_import_middle_proto"],
    deps = [
        ":public_import_middle_proto",
        ":public_import_private_dep_proto",
    ],
)
